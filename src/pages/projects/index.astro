---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import {site} from '../../data/site';
const projects=await getCollection('projects',({data})=>!data.draft);
---
<Layout title="Projects"><header class="page-head"><p class="eyebrow">02 / PROJECTS</p><h1>Work made tangible.</h1><p>Implementations, experiments, and tools—shown through what they actually produce.</p></header><div class="page-content">{['Research Projects','Things I Built'].map((category,i)=><section class="direction"><p class="eyebrow">0{i+1} / {i===0?'RESEARCH ARTIFACTS':'MAKING'}</p><div><h2>{category}</h2>{projects.filter(p=>p.data.category===category).length?projects.filter(p=>p.data.category===category).map(project=><article class="project-index-entry">{project.data.image&&<figure class="project-figure"><img src={project.data.image} alt={project.data.imageAlt??`${project.data.title} project preview`}/>{project.data.imageCaption&&<figcaption>{project.data.imageCaption}{project.data.imageSource&&<> · <a href={project.data.imageSource}>Source ↗</a></>}</figcaption>}</figure>}<h3><a href={project.data.links[0]?.url??site.github}>{project.data.title}</a></h3><p>{project.data.description}</p>{project.data.links.map(l=><a class="text-link" href={l.url}>{l.label} ↗</a>)}</article>):<><p>{i===0?'Model implementations, reproductions, benchmarks, and evaluation tools will be documented here with their real artifacts.':'Smaller tools, visualizations, and side projects will live here when they are ready to explain.'}</p><p class="sample-caption">The content model is ready; no placeholder project has been presented as finished work.</p></>}</div></section>)}<a class="text-link" href={site.github}>Elsewhere on GitHub ↗</a></div></Layout>
