---
import {getCollection} from 'astro:content';
const notes=(await getCollection('notes',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<div class="note-list">{notes.map(note=><a class="note-row" href={`/notes/${note.id}/`}><time datetime={note.data.date.toISOString()}>{note.data.date.toISOString().slice(0,10).replaceAll('-','.').slice(5)}<span class="year"> / {note.data.date.getUTCFullYear()}</span></time><div><h3>{note.data.title}</h3><p>{note.data.category}{note.data.sample?' · Sample entry':''}</p></div><span aria-hidden="true">↗</span></a>)}</div>
